# Real vendor exports and the filled-in crosswalk never enter this repo.
crosswalk.local.csv

# Internal planning docs. Stay on disk for reference while building;
# submitted separately, not via git.
docs/

# Excel files are ignored by default; only fabricated sample and fixture
# files are exceptions, matched by filename suffix. These are file-level
# patterns, never a directory-level one -- git does not descend into an
# ignored directory, so a directory ignore would make any exception
# underneath it silently unreachable. No leading slash on either exception,
# so both match at any depth (source samples in data/, fixtures in
# fixtures/, or anywhere else this repo ever grows to).
*.xlsx
!*_SAMPLE.xlsx
!*_FIXTURE.xlsx

# The validator's own output workbook (Step 4: validator/workbook.py,
# written to outputs/substation_report_<month>.xlsx). Already caught by
# the blanket *.xlsx rule above -- it doesn't end _SAMPLE.xlsx or
# _FIXTURE.xlsx -- but the whole directory is listed explicitly too, in
# case a future run ever writes something there that isn't .xlsx.
outputs/

# Python / environment
venv/
.venv/
__pycache__/
*.pyc
.env
