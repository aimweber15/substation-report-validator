# Real vendor exports and the filled-in crosswalk never enter this repo.
crosswalk.local.csv

# Internal planning docs: the repo holds no real data, but these hold the
# incident narrative for a named cooperative under a real byline -- a
# different exposure test than the sample/fixture data passes. Stay on
# disk for reference while building; submitted separately, not via git.
docs/

# Excel files are ignored by default; only fabricated sample and fixture
# files are exceptions, matched by filename suffix. These are file-level
# patterns, never a directory-level one -- git does not descend into an
# ignored directory, so a directory ignore would make any exception
# underneath it silently unreachable. No leading slash on either exception,
# so both match at any depth (source samples in data/, fixtures in
# fixtures/, or anywhere else this repo ever grows to).
*.xlsx
!*_SAMPLE.xlsx
!*_FIXTURE.xlsx

# The validator's own output workbook (Step 4 -- naming not finalized
# yet; already caught by the blanket *.xlsx rule above, listed explicitly
# so the intent survives even if that naming changes).
*_output.xlsx
*_reconciliation.xlsx
output/

# Python / environment
venv/
.venv/
__pycache__/
*.pyc
.env
